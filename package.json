{
  "name": "path-converter",
  "version": "1.2.12",
  "description": "パス変換ツール",
  "productName": "Path Converter",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build:mas": "electron-builder --mac mas --universal --publish never --dir || test -d 'mac/build/mas-universal/Path Converter.app'",
    "build:mas-signed": "npm run build:mas && ./scripts/sign-mas.sh",
    "build:win": "electron-builder --win --x64 --arm64 -c.directories.output=windows/build",
    "build:win-x64": "electron-builder --win --x64 -c.directories.output=windows/build",
    "build:win-arm64": "electron-builder --win --arm64 -c.directories.output=windows/build",
    "build:msix": "electron-builder --win --x64 && electron-windows-store --input-directory dist --output-directory msix --package-version 1.2.1 --package-name PathConverter --package-display-name \"Path Converter\" --package-description \"パス変換ツール\" --identity-name StudioTomippe.PathConverter --publisher-display-name \"Studio Tomippe\" --windows-kit \"C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.19041.0\\x64\" --dev-cert"
  },
  "author": "Studio Tomippe",
  "license": "ISC",
  "devDependencies": {
    "@electron/notarize": "^2.1.0",
    "dotenv": "^16.4.7",
    "electron": "25.9.8",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "jp.tomippe.pathconverter",
    "productName": "Path Converter",
    "artifactName": "${name}_${os}.${ext}",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "src/**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "mac",
      "output": "mac/build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "mac/icon.icns",
      "helperBundleId": "jp.tomippe.pathconverter.helper",
      "helperEHBundleId": "jp.tomippe.pathconverter.helper.eh",
      "helperGPUBundleId": "jp.tomippe.pathconverter.helper.gpu",
      "helperRendererBundleId": "jp.tomippe.pathconverter.helper.renderer",
      "helperPluginBundleId": "jp.tomippe.pathconverter.helper.plugin",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja", "en", "zh-Hans"],
        "NSHumanReadableCopyright": "Copyright © 2025 Studio Tomippe. All rights reserved.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "All Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ],
            "LSIsAppleDefaultForType": true
          }
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "File",
            "CFBundleURLSchemes": [
              "file"
            ]
          }
        ]
      }
    },
    "mas": {
      "provisioningProfile": "mac/PathConverter.provisionprofile",
      "entitlements": "mac/entitlements.mas.plist",
      "entitlementsInherit": "mac/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "mac/entitlements.mas.helper.plist",
      "helperBundleId": "jp.tomippe.pathconverter.helper",
      "helperEHBundleId": "jp.tomippe.pathconverter.helper.eh",
      "helperGPUBundleId": "jp.tomippe.pathconverter.helper.gpu",
      "helperRendererBundleId": "jp.tomippe.pathconverter.helper.renderer",
      "helperPluginBundleId": "jp.tomippe.pathconverter.helper.plugin"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "windows/resources/icon.ico"
    }
  }
}

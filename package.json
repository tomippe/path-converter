{
  "name": "path-converter",
  "version": "1.2.6",
  "description": "パス変換ツール",
  "productName": "Path Converter",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --universal",
    "build:win": "electron-builder --win --x64 --arm64",
    "build:win-x64": "electron-builder --win --x64",
    "build:win-arm64": "electron-builder --win --arm64",
    "build:msix": "electron-builder --win --x64 && electron-windows-store --input-directory dist --output-directory msix --package-version 1.2.1 --package-name PathConverter --package-display-name \"Path Converter\" --package-description \"パス変換ツール\" --identity-name StudioTomippe.PathConverter --publisher-display-name \"Studio Tomippe\" --windows-kit \"C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.19041.0\\x64\" --dev-cert"
  },
  "author": "Studio Tomippe",
  "license": "ISC",
  "devDependencies": {
    "@electron/notarize": "^2.1.0",
    "dotenv": "^16.4.7",
    "electron": "25.9.8",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "jp.tomippe.pathconverter",
    "productName": "Path Converter",
    "artifactName": "${name}_${os}.${ext}",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "src/**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "target": [
        "zip"
      ],
      "identity": "TOMIHIDE OTA",
      "provisioningProfile": null,
      "strictVerify": false,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "All Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ],
            "LSIsAppleDefaultForType": true
          }
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "File",
            "CFBundleURLSchemes": [
              "file"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    }
  }
}

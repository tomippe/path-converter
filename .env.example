# Copy to .env and fill in locally (never commit .env).
# Apple: prefer ~/.apple-env for APPLE_ID / APPLE_PASSWORD; app-specific password for notarize if needed.
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="XXXXXXXXXX"
BUNDLE_ID="jp.tomippe.pathconverter"

# Path Converter — WordPress app page (apps.tomippe.jp). Auth: ~/.wp-env
WP_APP_POST_ID=
WP_APP_PAGE_URL=https://apps.tomippe.jp/path-converter/
WP_POLICY_POST_ID=
WP_POLICY_PAGE_URL=https://apps.tomippe.jp/path-converter/policy/
